{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cumple-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": ["0,15,30 4,5 * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "TIME_ZONE": "America/New_York"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cumple-bot",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
