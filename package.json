{
  "name": "cumple-bot",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "instalar": "tsx scripts/instalar.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "comandos": "tsx --env-file=.dev.vars scripts/registrar-comandos.ts",
    "db:local": "wrangler d1 execute cumple-bot --local --file=schema.sql",
    "db:remota": "wrangler d1 execute cumple-bot --remote --file=schema.sql",
    "test": "vitest run",
    "tipos": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
